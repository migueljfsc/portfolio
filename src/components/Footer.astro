---
import { profile } from '../data/cv';
import { u } from '../lib/url';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="hello">
    <p class="hello-title">Want to talk infrastructure, football or motorbikes?</p>
    <a class="hello-mail" href={`mailto:${profile.email}`}>{profile.email}</a>
  </div>
  <div class="base">
    <span>© {year} {profile.name}, {profile.location}</span>
    <nav class="links" aria-label="Elsewhere">
      <a href={profile.github} target="_blank" rel="noopener">GitHub</a>
      <a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={u(profile.resume)} target="_blank" rel="noopener">Résumé</a>
    </nav>
  </div>
</footer>

<style>
  .footer { margin-top: clamp(5rem, 11vw, 8rem); }

  .hello {
    padding: 2.5rem 0;
    border-top: 1px solid var(--border);
  }
  .hello-title {
    font-size: var(--step-2);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.15;
    max-width: 22ch;
  }
  .hello-mail {
    display: inline-block;
    margin-top: 1rem;
    font-size: var(--step-1);
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    overflow-wrap: anywhere;
  }
  .hello-mail:hover { color: var(--accent); }

  .base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: var(--step--1);
    color: var(--text-dim);
  }
  .links { display: flex; gap: 1.25rem; }
  .links a { color: var(--text-muted); }
  .links a:hover { color: var(--accent); }
</style>
