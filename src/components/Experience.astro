---
import { experience, education, type Role } from '../data/cv';
import { slug } from '../lib/slug';

const groups: { heading: string; entries: Role[] }[] = [
  { heading: 'Experience', entries: experience },
  { heading: 'Education', entries: education },
];
const isCurrent = (r: Role) => /present/i.test(r.period);
---

{groups.map(g => (
  <section class="ledger">
    <h2 class="section-title">{g.heading}</h2>
    <ol class="entries">
      {g.entries.map(role => (
        <li class="entry" id={slug(role.company)}>
          <div class="when">
            <span class="period">{role.period}</span>
            <span class="where">{role.location}</span>
          </div>
          <div class="what">
            <div class="head">
              <h3 class="company">{role.company}</h3>
              {isCurrent(role) && <span class="status wip">current</span>}
            </div>
            <p class="title">{role.title}</p>
            <ul class="bullets">
              {role.bullets.map(b => <li>{b}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </section>
))}

<style>
  .ledger { margin-top: 4.5rem; }
  .section-title { margin-bottom: 1.25rem; }

  .entries { list-style: none; border-top: 1px solid var(--border); }

  .entry {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 0.5rem 2rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 2rem;
  }
  .entry:target .company { color: var(--accent); }

  .when {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-top: 0.45rem;
    font-family: var(--mono);
    font-size: 0.75rem;
  }
  .period { color: var(--text-muted); white-space: nowrap; }
  .where { color: var(--text-dim); }

  .head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.85rem; }
  .company {
    font-size: var(--step-2);
    font-weight: 700;
    font-stretch: 85%;
    letter-spacing: -0.035em;
    line-height: 1.1;
    transition: color 0.3s;
  }
  .title { margin: 0.25rem 0 1rem; color: var(--text-muted); }

  .bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    max-width: 66ch;
  }
  .bullets li {
    position: relative;
    padding-left: 1.25rem;
    line-height: 1.6;
  }
  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 0.5rem;
    height: 2px;
    background: var(--border-lit);
  }

  @media (max-width: 600px) {
    .entry { grid-template-columns: 1fr; }
    .when { flex-direction: row; gap: 1rem; padding-top: 0; }
  }
</style>
