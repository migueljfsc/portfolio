---
import { experience as roles, education } from '../data/cv';
---

<section>
  <p class="section-label reveal">Experience</p>

  <div class="timeline">
    {roles.map(role => (
      <div class="role reveal">
        <div class="role-meta">
          <span class="role-period">{role.period}</span>
          <span class="role-location">{role.location}</span>
        </div>
        <div class="role-body">
          <p class="role-company">{role.company}</p>
          <p class="role-title">{role.title}</p>
          <ul class="role-bullets">
            {role.bullets.map(b => <li>{b}</li>)}
          </ul>
        </div>
      </div>
    ))}
  </div>

  <p class="sub-label reveal">Education</p>

  <div class="timeline">
    {education.map(role => (
      <div class="role reveal">
        <div class="role-meta">
          <span class="role-period">{role.period}</span>
          <span class="role-location">{role.location}</span>
        </div>
        <div class="role-body">
          <p class="role-company">{role.company}</p>
          <p class="role-title">{role.title}</p>
          <ul class="role-bullets">
            {role.bullets.map(b => <li>{b}</li>)}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }

  .sub-label {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-2);
    margin: 3.25rem 0 2.25rem;
  }

  .sub-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--border), transparent);
  }

  .role {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 0 1.5rem;
  }

  @media (max-width: 540px) {
    .role { grid-template-columns: 1fr; gap: 0.4rem; }
  }

  .role-body {
    border-left: 1px solid var(--border);
    padding-left: 1.5rem;
    position: relative;
    transition: border-color 0.2s;
  }

  .role-body::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 0.35rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--border-lit);
    transition: background 0.2s, box-shadow 0.2s;
  }

  .role:hover .role-body { border-color: var(--accent-dim); }
  .role:hover .role-body::before {
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  @media (max-width: 540px) {
    .role-body { border-left: none; padding-left: 1rem; }
    .role-body::before { left: 0; }
  }

  .role-meta {
    padding-top: 0.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .role-period {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .role-location {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--text-dim);
  }

  .role-company {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--accent);
    margin-bottom: 0.15rem;
  }

  .role-title {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .role-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .role-bullets li {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.6;
    padding-left: 1rem;
    position: relative;
  }

  .role-bullets li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--text-dim);
  }
</style>
