---
import { about } from '../data/cv';
---
<section class="about">
  <h2 class="section-title">About</h2>
  <div class="body">
    {about.map(paragraph => <p>{paragraph}</p>)}
  </div>
</section>

<style>
  .section-title { margin-bottom: 1.25rem; }
  .body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 62ch;
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .body p:first-child { font-size: var(--step-1); line-height: 1.45; letter-spacing: -0.01em; }
  .body p + p { color: var(--text-muted); }
</style>
