---
import { projects } from '../data/cv';

interface Props {
  heading?: string;
  limit?: number;
  viewAllHref?: string;
}
const { heading, limit, viewAllHref } = Astro.props;
const linked = projects.filter(p => p.href);
const pending = projects.filter(p => !p.href);
const list = limit ? linked.slice(0, limit) : linked;
const host = (href: string) => new URL(href).hostname.replace(/^www\./, '');
---

<section class="projects">
  {heading && (
    <div class="section-head">
      <h2 class="section-title">{heading}</h2>
      {viewAllHref && <a class="section-link" href={viewAllHref}>All {linked.length} projects</a>}
    </div>
  )}

  <ul class="rows">
    {list.map(p => (
      <li>
        <a class="row" href={p.href} target="_blank" rel="noopener">
          <div class="head">
            <h3 class="name">{p.name}</h3>
            <span class:list={['status', p.wip ? 'wip' : 'live']}>{p.wip ? 'in progress' : 'live'}</span>
          </div>
          <div class="detail">
            <p class="desc">{p.description}</p>
            <p class="meta">
              <span class="tags">{p.tags.join(', ')}</span>
              <span class="host">{host(p.href)} <span aria-hidden="true">↗</span></span>
            </p>
          </div>
        </a>
      </li>
    ))}
    {!limit && pending.map(p => (
      <li class="row pending">
        <div class="head"><h3 class="name">{p.name}</h3></div>
        <div class="detail"><p class="desc">{p.description}</p></div>
      </li>
    ))}
  </ul>
</section>

<style>
  .rows {
    list-style: none;
    border-top: 1px solid var(--border);
  }
  .rows > li { border-bottom: 1px solid var(--border); }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
    gap: 0.75rem 2.5rem;
    padding: 1.75rem 1rem;
    margin: 0 -1rem;
    color: inherit;
    border-radius: 6px;
    transition: background 0.18s;
  }
  a.row:hover { background: var(--bg-hover); }
  a.row:hover .name { color: var(--accent); }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-content: start;
    gap: 0.6rem 0.85rem;
  }
  .name {
    font-size: var(--step-2);
    font-weight: 700;
    font-stretch: 85%;
    letter-spacing: -0.035em;
    line-height: 1;
    transition: color 0.15s;
  }

  .desc {
    max-width: 62ch;
    color: var(--text);
    opacity: 0.85;
    line-height: 1.6;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1.5rem;
    margin-top: 0.9rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--text-dim);
  }
  .host { color: var(--text-muted); }

  .pending .name { color: var(--text-dim); font-size: var(--step-1); }
  .pending .desc { color: var(--text-muted); opacity: 1; }

  @media (max-width: 760px) {
    .row { grid-template-columns: 1fr; padding: 1.4rem 1rem; }
  }
</style>
