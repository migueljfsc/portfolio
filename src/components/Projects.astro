---
import { projects } from '../data/cv';
---

<section>
  <p class="section-label reveal">Projects</p>

  <div class="projects-grid reveal">
    {projects.map(p => (
      <a class="card" href={p.href} target="_blank" rel="noopener">
        <div class="card-header">
          <span class="card-name">{p.name}</span>
          {p.wip && <span class="wip-badge">WIP</span>}
          <span class="card-arrow">↗</span>
        </div>
        <p class="card-desc">{p.description}</p>
        <ul class="card-tags">
          {p.tags.map(t => <li>{t}</li>)}
        </ul>
      </a>
    ))}
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--bg-card);
    color: inherit;
    transition: background 0.2s, box-shadow 0.2s;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  /* gradient sheen that sweeps in on hover */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 0%),
                rgba(156, 176, 128, 0.10), transparent 45%);
    opacity: 0;
    transition: opacity 0.25s;
    pointer-events: none;
  }

  .card:hover {
    background: var(--bg-hover);
    box-shadow: inset 0 0 0 1px var(--border-lit);
    opacity: 1;
  }
  .card:hover::before { opacity: 1; }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .card-name {
    font-family: var(--mono);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text);
    flex: 1;
  }

  .card-arrow {
    font-size: 0.8rem;
    color: var(--text-muted);
    transition: color 0.15s, transform 0.15s;
  }
  .card:hover .card-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .wip-badge {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    border: 1px solid var(--accent-dim);
    padding: 0.1rem 0.35rem;
    border-radius: 2px;
  }

  .card-desc {
    font-size: 0.83rem;
    color: var(--text-muted);
    line-height: 1.6;
    flex: 1;
  }

  .card-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .card-tags li {
    font-family: var(--mono);
    font-size: 0.65rem;
    color: var(--text-dim);
    letter-spacing: 0.04em;
  }

  .card-tags li:not(:last-child)::after {
    content: ' ·';
    margin-left: 0.4rem;
  }
</style>
