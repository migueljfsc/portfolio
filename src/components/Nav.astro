---
import { profile } from '../data/cv';
import ThemeToggle from './ThemeToggle.astro';
import { u } from '../lib/url';

const tabs = [
  { label: 'Writing', path: '/blog', href: u('blog') },
  { label: 'Projects', path: '/projects', href: u('projects') },
  { label: 'CV', path: '/cv', href: u('cv') },
];

// Current path with the configured base stripped, normalised (no trailing slash).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
let cur = Astro.url.pathname;
if (base && cur.startsWith(base)) cur = cur.slice(base.length);
cur = cur.replace(/\/$/, '') || '/';

// Home matches exactly; others also match their sub-routes (e.g. /blog/post).
const isActive = (p: string) =>
  p === '/' ? cur === '/' : cur === p || cur.startsWith(p + '/');
---
<nav class="nav" aria-label="Main">
  <a class="brand" href={u('')} aria-current={isActive('/') ? 'page' : undefined}>
    <svg class="mark" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="5" cy="12" r="3" />
      <circle cx="19" cy="12" r="3" />
      <path d="M8 12h8" />
    </svg>
    <span>{profile.name}</span>
  </a>
  <div class="nav-right">
    <ul class="tabs">
      {tabs.map(t => (
        <li>
          <a href={t.href} class:list={["tab", { active: isActive(t.path) }]} aria-current={isActive(t.path) ? 'page' : undefined}>
            {t.label}
          </a>
        </li>
      ))}
    </ul>
    <ThemeToggle />
  </div>
</nav>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 650;
    font-size: 1.02rem;
    letter-spacing: -0.015em;
    color: var(--text);
  }
  .mark {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    transition: transform 0.35s var(--ease-out);
  }
  .brand:hover .mark { transform: rotate(-12deg); }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .tabs {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
  }

  .tab {
    position: relative;
    display: block;
    font-size: 0.94rem;
    color: var(--text-muted);
    padding: 0.4rem 0.7rem;
  }
  .tab::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.1rem;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease-out);
  }
  .tab:hover { color: var(--text); }
  .tab:hover::after { transform: scaleX(0.4); }
  .tab.active { color: var(--text); }
  .tab.active::after { transform: scaleX(1); }

  @media (max-width: 560px) {
    .brand span { display: none; }
    .tab { padding: 0.4rem 0.5rem; }
    .tab::after { left: 0.5rem; right: 0.5rem; }
  }
</style>
