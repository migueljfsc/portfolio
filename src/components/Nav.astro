---
import { profile } from '../data/cv';
import ThemeToggle from './ThemeToggle.astro';
import { u } from '../lib/url';

const tabs = [
  { label: 'Home', path: '/', href: u('') },
  { label: 'Blog', path: '/blog', href: u('blog') },
  { label: 'Projects', path: '/projects', href: u('projects') },
  { label: 'CV', path: '/cv', href: u('cv') },
];

// Current path with the configured base stripped, normalised (no trailing slash).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
let cur = Astro.url.pathname;
if (base && cur.startsWith(base)) cur = cur.slice(base.length);
cur = cur.replace(/\/$/, '') || '/';

// Home matches exactly; others also match their sub-routes (e.g. /blog/post).
const isActive = (p: string) =>
  p === '/' ? cur === '/' : cur === p || cur.startsWith(p + '/');
---
<nav class="nav">
  <a class="brand" href={u('')}>{profile.name}</a>
  <div class="nav-right">
    <ul class="tabs">
      {tabs.map(t => (
        <li>
          <a href={t.href} class:list={["tab", { active: isActive(t.path) }]}>
            {t.label}
          </a>
        </li>
      ))}
    </ul>
    <ThemeToggle />
  </div>
</nav>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0 1.75rem;
    margin-bottom: 1.5rem;
  }

  .brand {
    font-family: var(--mono);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .brand:hover { color: var(--accent); opacity: 1; }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .tabs {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
  }

  .tab {
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--text-muted);
    padding: 0.4rem 0.7rem;
    border-radius: 6px;
    transition: color 0.18s, background 0.18s;
  }
  .tab:hover { color: var(--accent); background: var(--bg-hover); opacity: 1; }
  .tab.active { color: var(--accent); background: var(--bg-hover); }

  @media (max-width: 520px) {
    .nav { flex-wrap: wrap; padding-bottom: 1.25rem; }
    .nav-right { gap: 0.75rem; }
    .tab { padding: 0.4rem 0.55rem; }
  }
</style>
