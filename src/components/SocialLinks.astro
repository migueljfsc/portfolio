---
import { profile } from '../data/cv';
import { u } from '../lib/url';
---
<div class="links">
  <a class="btn primary" href={`mailto:${profile.email}`}>Email me</a>
  <a class="btn" href={u(profile.resume)} target="_blank" rel="noopener">Résumé (PDF)</a>
  <span class="icons">
  <a class="icon" href={profile.github} target="_blank" rel="noopener" aria-label="GitHub">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.2 3.44 9.6 8.21 11.16.6.11.82-.25.82-.56v-2.1c-3.34.72-4.04-1.4-4.04-1.4-.55-1.36-1.34-1.72-1.34-1.72-1.09-.73.08-.72.08-.72 1.2.08 1.84 1.22 1.84 1.22 1.07 1.8 2.81 1.28 3.5.98.11-.76.42-1.28.76-1.57-2.67-.3-5.47-1.31-5.47-5.84 0-1.29.47-2.34 1.23-3.17-.12-.3-.53-1.52.12-3.17 0 0 1-.32 3.3 1.21a11.6 11.6 0 0 1 6 0c2.28-1.53 3.29-1.21 3.29-1.21.65 1.65.24 2.87.12 3.17.77.83 1.23 1.88 1.23 3.17 0 4.54-2.81 5.53-5.49 5.83.43.37.81 1.1.81 2.22v3.29c0 .31.22.68.83.56A12.02 12.02 0 0 0 24 12.29C24 5.78 18.63.5 12 .5z"/></svg>
  </a>
  <a class="icon" href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
  </a>
  </span>
</div>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    height: 2.6rem;
    padding: 0 1.15rem;
    border-radius: 999px;
    border: 1px solid var(--border-lit);
    color: var(--text);
    font-weight: 550;
    font-size: 0.94rem;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .btn:hover { border-color: var(--text-muted); background: var(--bg-hover); }

  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .btn.primary:hover { background: var(--text); border-color: var(--text); color: var(--bg); }

  .icons { display: inline-flex; gap: 0.15rem; }

  .icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    color: var(--text-muted);
    transition: color 0.15s, background 0.15s;
  }
  .icon:hover { color: var(--text); background: var(--bg-hover); }
  .icon svg { width: 20px; height: 20px; fill: currentColor; }
</style>
