---
import { profile } from '../data/cv';
import { u } from '../lib/url';
---
<nav class="social-links">
  <a href={profile.github} target="_blank" rel="noopener" aria-label="GitHub">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.2 3.44 9.6 8.21 11.16.6.11.82-.25.82-.56v-2.1c-3.34.72-4.04-1.4-4.04-1.4-.55-1.36-1.34-1.72-1.34-1.72-1.09-.73.08-.72.08-.72 1.2.08 1.84 1.22 1.84 1.22 1.07 1.8 2.81 1.28 3.5.98.11-.76.42-1.28.76-1.57-2.67-.3-5.47-1.31-5.47-5.84 0-1.29.47-2.34 1.23-3.17-.12-.3-.53-1.52.12-3.17 0 0 1-.32 3.3 1.21a11.6 11.6 0 0 1 6 0c2.28-1.53 3.29-1.21 3.29-1.21.65 1.65.24 2.87.12 3.17.77.83 1.23 1.88 1.23 3.17 0 4.54-2.81 5.53-5.49 5.83.43.37.81 1.1.81 2.22v3.29c0 .31.22.68.83.56A12.02 12.02 0 0 0 24 12.29C24 5.78 18.63.5 12 .5z"/></svg>
    <span>GitHub</span>
  </a>
  <a href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
    <span>LinkedIn</span>
  </a>
  <a href={`mailto:${profile.email}`} aria-label="Email">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 4H2a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h20a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1Zm-1.4 2L12 12.06 3.4 6h17.2ZM3 18V7.27l8.43 5.94a1 1 0 0 0 1.14 0L21 7.27V18H3Z"/></svg>
    <span>Email</span>
  </a>
  <a href={u(profile.resume)} target="_blank" rel="noopener" aria-label="Résumé">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Zm-.5 1.5L18.5 8H14a.5.5 0 0 1-.5-.5V3.5ZM8 12.5h8V14H8v-1.5Zm0 3.2h8v1.5H8v-1.5ZM8 9.3h3.5v1.5H8V9.3Z"/></svg>
    <span>Résumé</span>
  </a>
</nav>

<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-family: var(--mono);
    font-size: 0.78rem;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    transition: border-color 0.18s, color 0.18s, background 0.18s,
                box-shadow 0.18s, transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .social-links a:hover {
    color: var(--accent);
    border-color: var(--border-lit);
    background: var(--bg-hover);
    box-shadow: var(--glow);
    opacity: 1;
    transform: translateY(-3px);
  }

  .social-links a:active { transform: translateY(-1px) scale(0.97); }

  .social-links svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
    flex-shrink: 0;
  }
</style>
