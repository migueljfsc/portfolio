---
---
<button id="theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle theme">
  <!-- Moon (shown in dark mode → click for light) -->
  <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
  <!-- Sun (shown in light mode → click for dark) -->
  <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2"/>
    <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <line x1="12" y1="1.5" x2="12" y2="4"/>
      <line x1="12" y1="20" x2="12" y2="22.5"/>
      <line x1="1.5" y1="12" x2="4" y2="12"/>
      <line x1="20" y1="12" x2="22.5" y2="12"/>
      <line x1="4.4" y1="4.4" x2="6.2" y2="6.2"/>
      <line x1="17.8" y1="17.8" x2="19.6" y2="19.6"/>
      <line x1="4.4" y1="19.6" x2="6.2" y2="17.8"/>
      <line x1="17.8" y1="6.2" x2="19.6" y2="4.4"/>
    </g>
  </svg>
</button>

<style>
  #theme-toggle {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: color-mix(in srgb, var(--bg-card) 75%, transparent);
    backdrop-filter: blur(8px);
    color: var(--text-muted);
    cursor: pointer;
    transition: border-color 0.18s, color 0.18s, background 0.18s, box-shadow 0.18s;
  }

  #theme-toggle:hover {
    color: var(--accent);
    border-color: var(--border-lit);
    box-shadow: var(--glow);
  }

  #theme-toggle svg {
    grid-area: 1 / 1;
    width: 18px;
    height: 18px;
    fill: currentColor;
    transition: opacity 0.25s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Default (dark): show moon, hide sun */
  .icon-sun  { opacity: 0; transform: rotate(-90deg) scale(0.6); }
  .icon-moon { opacity: 1; transform: none; }

  :global(:root[data-theme="light"]) .icon-sun  { opacity: 1; transform: none; }
  :global(:root[data-theme="light"]) .icon-moon { opacity: 0; transform: rotate(90deg) scale(0.6); }

  @media (prefers-reduced-motion: reduce) {
    #theme-toggle svg { transition: opacity 0.15s ease; }
    .icon-sun { transform: none; }
  }
</style>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>
