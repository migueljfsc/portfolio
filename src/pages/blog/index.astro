---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Layout title="Writing — Miguel Cardoso" description="Writing on infrastructure, DevOps, and side projects.">
  <section class="wrap">
    <header class="page-head">
      <h1 class="page-title">Writing</h1>
      <p class="page-sub">Notes on infrastructure, the side projects I'm building, and what I learn along the way.</p>
    </header>
    <PostList posts={posts} showTags />
  </section>
</Layout>
