---
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import CareerGraph from '../components/CareerGraph.astro';
import Projects from '../components/Projects.astro';
import PostList from '../components/PostList.astro';
import { profile } from '../data/cv';
import { getCollection } from 'astro:content';
import { u } from '../lib/url';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---
<Layout title={`${profile.name}, ${profile.title}`}>
  <section class="hero">
    <h1 class="headline">{profile.headline}</h1>
    <p class="summary">{profile.summary}</p>
    <SocialLinks />
  </section>

  <section class="career" aria-label="Career">
    <CareerGraph />
  </section>

  <div class="block">
    <Projects heading="What I'm building" limit={3} viewAllHref={u('projects')} />
  </div>

  <section class="block">
    <div class="section-head">
      <h2 class="section-title">Writing</h2>
      <a class="section-link" href={u('blog')}>All posts</a>
    </div>
    <PostList posts={posts} />
  </section>
</Layout>

<style>
  .hero {
    padding: clamp(3rem, 10vw, 7.5rem) 0 clamp(2.5rem, 6vw, 4.5rem);
    animation: rise 0.6s var(--ease-out) both;
  }

  .headline {
    font-size: var(--step-4);
    font-weight: 700;
    font-stretch: 88%;
    line-height: 0.95;
    letter-spacing: -0.028em;
    max-width: 14ch;
  }

  .summary {
    max-width: 54ch;
    margin: 1.75rem 0 2.25rem;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .career {
    padding: 2.5rem 0 1rem;
    border-top: 1px solid var(--border);
  }

  .block { margin-top: clamp(4rem, 9vw, 6.5rem); }

  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: none; }
  }
</style>
