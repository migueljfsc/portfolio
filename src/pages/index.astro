---
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Projects from '../components/Projects.astro';
import { profile, about } from '../data/cv';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Layout>
  <section class="intro">
    <p class="eyebrow reveal">{profile.location}</p>
    <h1 class="name reveal">
      <span class="name-text">{profile.name}</span>
      <svg class="flag" viewBox="0 0 30 20" role="img" aria-label="Portugal">
        <rect width="12" height="20" fill="#006600" />
        <rect x="12" width="18" height="20" fill="#d52b1e" />
        <circle cx="12" cy="10" r="3.3" fill="none" stroke="#ffcc00" stroke-width="0.9" />
        <rect x="10.6" y="7.4" width="2.8" height="5.2" rx="0.4" fill="#fff" stroke="#d52b1e" stroke-width="0.7" />
      </svg>
    </h1>
    <p class="lede reveal">{profile.title}. {about[0]}</p>
    <div class="reveal"><SocialLinks /></div>
  </section>

  <section class="home-block">
    <p class="section-label reveal">Latest posts</p>
    <ul class="posts">
      {posts.map(p => (
        <li class="reveal">
          <a class="post" href={`/blog/${p.id}`}>
            <span class="post-date">{fmt(p.data.date)}</span>
            <span class="post-title">{p.data.title}</span>
            <span class="post-desc">{p.data.description}</span>
          </a>
        </li>
      ))}
    </ul>
    <a class="view-all reveal" href="/blog">all posts →</a>
  </section>

  <div class="home-block">
    <Projects heading="Featured projects" limit={2} viewAllHref="/projects" />
  </div>
</Layout>

<style>
  .intro { max-width: 640px; margin-bottom: 4.5rem; }

  .eyebrow {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
  }

  .name {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45em;
    font-size: clamp(2.4rem, 7vw, 3.6rem);
    line-height: 1.05;
    margin-bottom: 1.25rem;
  }
  .name-text {
    background: linear-gradient(
      110deg, var(--name-start) 8%, var(--accent) 38%, var(--accent-3) 64%, var(--accent-2) 100%
    );
    background-size: 220% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: name-shift 9s ease-in-out infinite alternate;
  }
  .flag {
    height: 0.6em;
    width: auto;
    border-radius: 2px;
    flex-shrink: 0;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.18);
  }
  @keyframes name-shift {
    0% { background-position: 0% 50%; }
    100% { background-position: 100% 50%; }
  }
  @media (prefers-reduced-motion: reduce) { .name-text { animation: none; } }

  .lede {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .home-block { margin-top: 4rem; }

  .posts { list-style: none; display: flex; flex-direction: column; gap: 1.25rem; }
  .post { display: flex; flex-direction: column; gap: 0.25rem; color: inherit; }
  .post:hover { opacity: 1; }
  .post:hover .post-title { color: var(--accent); }
  .post-date { font-family: var(--mono); font-size: 0.7rem; color: var(--text-dim); }
  .post-title {
    font-family: var(--mono); font-size: 1rem; font-weight: 600; color: var(--text);
    transition: color 0.18s;
  }
  .post-desc { font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; }

  .view-all {
    display: inline-block;
    margin-top: 1.4rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--accent);
  }
  .view-all:hover { opacity: 1; text-decoration: underline; }
</style>
