---
// Print-only A4 résumé. Self-contained (no site layout/fonts) so it renders
// deterministically to PDF via scripts/generate-pdf.mjs. Content from cv.ts.
import { profile, about, experience, education, skills } from '../data/cv';

const strip = (url: string) =>
  url.replace(/^https?:\/\//, '').replace(/^www\./, '').replace(/\/$/, '');

const contacts = [
  profile.location,
  profile.email,
  strip(profile.github),
  strip(profile.linkedin),
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{profile.name} — Résumé</title>
  </head>
  <body>
    <header class="head">
      <h1>{profile.name}</h1>
      <p class="title">{profile.title}</p>
      <p class="contacts">{contacts.join("  ·  ")}</p>
    </header>

    <section>
      <h2>Profile</h2>
      {about.map(p => <p class="para">{p}</p>)}
    </section>

    <section>
      <h2>Experience</h2>
      {experience.map(role => (
        <div class="entry">
          <div class="entry-head">
            <span class="entry-title">{role.title} · {role.company}</span>
            <span class="entry-period">{role.period}</span>
          </div>
          <ul>
            {role.bullets.map(b => <li>{b}</li>)}
          </ul>
        </div>
      ))}
    </section>

    <section>
      <h2>Education</h2>
      {education.map(role => (
        <div class="entry">
          <div class="entry-head">
            <span class="entry-title">{role.title} · {role.company}</span>
            <span class="entry-period">{role.period}</span>
          </div>
          <ul>
            {role.bullets.map(b => <li>{b}</li>)}
          </ul>
        </div>
      ))}
    </section>

    <section>
      <h2>Skills</h2>
      {skills.map(group => (
        <p class="skill-row">
          <span class="skill-cat">{group.category}</span>
          <span>{group.items.join(", ")}</span>
        </p>
      ))}
    </section>
  </body>
</html>

<style>
  @page { size: A4; margin: 0; }

  :root {
    --ink: #1a1a1a;
    --muted: #555;
    --accent: #4f6f52;
    --rule: #d8d8d8;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: -apple-system, "Helvetica Neue", Arial, sans-serif;
    color: var(--ink);
    font-size: 10.5pt;
    line-height: 1.4;
    background: #fff;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .head { margin-bottom: 14px; }

  h1 {
    font-size: 22pt;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--accent);
  }

  .title {
    font-size: 11pt;
    font-weight: 600;
    color: var(--ink);
    margin-top: 1px;
  }

  .contacts {
    font-size: 8.7pt;
    color: var(--muted);
    margin-top: 5px;
  }

  section { margin-top: 14px; }

  h2 {
    font-size: 9pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--accent);
    padding-bottom: 3px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 7px;
  }

  .para { margin-bottom: 4px; }

  .entry { margin-bottom: 9px; break-inside: avoid; }

  .entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .entry-title { font-weight: 600; font-size: 10.5pt; }

  .entry-period {
    font-size: 8.7pt;
    color: var(--muted);
    white-space: nowrap;
  }

  .entry ul { margin-top: 3px; padding-left: 15px; }

  .entry li { margin-bottom: 2px; }

  .skill-row {
    display: flex;
    gap: 10px;
    margin-bottom: 3px;
  }

  .skill-cat {
    flex: 0 0 110px;
    font-weight: 600;
    color: var(--accent);
  }
</style>
